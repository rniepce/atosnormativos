# ── PostgreSQL (pgvector) ────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=tjmg_rag

# ── Azure OpenAI (GPT-4.1-mini + Embeddings) ───────────────────
AZURE_API_KEY=YOUR_AZURE_API_KEY_HERE
AZURE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_API_VERSION=2025-01-01-preview
AZURE_LLM_MODEL=gpt-4.1-mini
AZURE_EMBEDDING_MODEL=text-embedding-3-large
AZURE_EMBEDDING_DIMENSIONS=1024

# ── GCP Credentials (for Vertex AI - optional) ──────────────────
# GCP_PROJECT_ID=your-project-id
# GCP_LOCATION=southamerica-east1
# GOOGLE_CREDENTIALS_JSON={"type": "service_account", ...}

# ── Gemini API Key (for google-generativeai SDK) ────────────────
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── Amazônia IA API Key (OpenAI-compatible) ─────────────────────
# AMAZONIA_API_KEY=YOUR_AMAZONIA_API_KEY_HERE

# ── Segurança (Protótipo) ───────────────────────────────────────
# Chave para proteger endpoints de upload/admin (gere uma com: python -c "import secrets; print(secrets.token_urlsafe(32))")
UPLOAD_API_KEY=CHANGE_ME_GENERATE_A_SECRET

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Rate limiting (requisições por minuto por IP)
RATE_LIMIT=30/minute

# ── Ingestion ─────────────────────────────────────────────────────
# Directory containing Word documents for ingestion
# SOURCE_DIR=/path/to/your/word/docs
